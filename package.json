{
  "name": "artemis-city-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace coordinator for Artemis City JavaScript projects.",
  "keywords": [
    "ATP"
  ],
  "homepage": "https://github.com/AgenticGovernace/AgenticGovernance-ArtemisCity#readme",
  "bugs": {
    "url": "https://github.com/AgenticGovernace/AgenticGovernance-ArtemisCity/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgenticGovernace/AgenticGovernance-ArtemisCity.git"
  },
  "license": "Apache-2.0",
  "author": "Prinston Palmer",
  "type": "commonjs",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "workspaces": [
    "app/api",
    "app/web/frontend"
  ],
  "scripts": {
    "api:build": "npm --prefix app/api run build",
    "api:start": "npm --prefix app/api run start",
    "api:dev": "npm --prefix app/api run dev",
    "api:typecheck": "npm --prefix app/api run typecheck",
    "frontend:build": "npm --prefix app/web/frontend run build",
    "frontend:dev": "npm --prefix app/web/frontend run dev",
    "frontend:typecheck": "npm --prefix app/web/frontend run typecheck",
    "build": "npm run api:build && npm run frontend:build",
    "dev": "npm run api:dev",
    "lint": "eslint .",
    "typecheck": "npm run api:typecheck && npm run frontend:typecheck",
    "test": "npm --prefix app/api run test"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "artemis-city-workspace": "link:",
    "requirements": "^4.0.2"
  }
}
