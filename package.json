{
  "name": "artemis-city-api",
  "version": "0.1.0",
  "private": true,
  "description": "Express TypeScript HTTP boundary for the Artemis City Python core.",
  "keywords": [
    "ATP"
  ],
  "homepage": "https://github.com/AgenticGovernace/AgenticGovernance-ArtemisCity#readme",
  "bugs": {
    "url": "https://github.com/AgenticGovernace/AgenticGovernance-ArtemisCity/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgenticGovernace/AgenticGovernance-ArtemisCity.git"
  },
  "license": "Apache-2.0",
  "author": "Prinston Palmer",
  "type": "commonjs",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only app/api/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "uvicorn": "^0.0.1-security",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=24"
  }
}
