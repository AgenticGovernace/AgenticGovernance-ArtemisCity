# ============================================
# 🏛️ ARTEMIS CITY - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# ============================================
# 🌐 ACTIVE ENVIRONMENT
# ============================================
# Selects which file in config/environments/ is loaded.
# Must be one of: dev, staging, prod. Defaults to dev when unset.
ARTEMIS_ENV=dev

# ============================================
# 🔐 MCP SERVER CONFIGURATION
# ============================================

# MCP Server base URL (default: http://localhost:3000)
MCP_BASE_URL=http://localhost:3000

# MCP API Key for authentication (required)
# Generate a secure random key: openssl rand -hex 32
MCP_API_KEY=your_secure_api_key_here

# ============================================
# 📚 OBSIDIAN CONFIGURATION
# ============================================

# Obsidian Local REST API base URL
# Default when running locally: http://localhost:27124
# Docker on Mac/Windows: http://host.docker.internal:27124
OBSIDIAN_BASE_URL=http://localhost:27124

# Obsidian Local REST API Key
# Get this from Obsidian -> Settings -> Local REST API
OBSIDIAN_API_KEY=your_obsidian_api_key_here

# ============================================
# 🔧 OPTIONAL CONFIGURATION
# ============================================

# MCP Server Port (if running the server)
PORT=3000

# Log Level: DEBUG, INFO, WARN, ERROR
MCP_LOG_LEVEL=INFO

# Python virtual environment path (if non-standard)
VIRTUAL_ENV=
# ============================================
# EXO CLUSTER (local LLM inference)
# ============================================

# EXO API base URL (default: http://localhost:52415)
EXO_BASE_URL=http://localhost:52415

# Explicit model ID — leave blank to auto-detect from the running cluster
EXO_MODEL_ID=

# ============================================
# ANACONDA AGENT STUDIO STACK
# ============================================
# When Anaconda Agent Studio is running with the six-agent stack
# (~/Source/artemis-agent-stack/: oracle, compsuite, packrat, compressor,
# loki, validators-tools), the orchestrator can register each running
# agent into AgentRegistry via src/integration/anaconda_stack.py.
#
# Anaconda Desktop binds its discovery endpoint to a stable localhost
# port. Per-agent chat endpoints get fresh ports on every restart, so
# the port map below must be refreshed after each `Stop -> Start` cycle
# in Agent Studio. Find each port in the agent's
# Connection Info -> Runtime root URL.

# Anaconda Desktop discovery URL (lists running agents at /api/agents/v1/models).
ANACONDA_DESKTOP_URL=http://127.0.0.1:54321

# Bearer token sent to both the discovery endpoint and per-agent chat
# endpoints. Agent Studio (Beta) ships with a permissive default key of
# `*` -- any non-empty bearer is accepted. Override only if you've
# configured a real API key in Agent Studio's settings.
ANACONDA_API_KEY=*

# Per-agent runtime ports. Format: name:port,name:port. Agents whose name
# is not in this map are not registered, even if Agent Studio is running
# them. Leave blank to disable Anaconda integration entirely.
# Example with all five LLM agents:
# ANACONDA_AGENT_PORTS=artemis-oracle:50053,artemis-loki:50054,artemis-compsuite:50055,artemis-packrat:50056,artemis-compressor:50057
ANACONDA_AGENT_PORTS=

# ============================================
# EXTERNAL API KEYS (Add as needed)
# ============================================

# OpenAI API Key (if using AI features)
# OPENAI_API_KEY=sk-...

# Anthropic API Key (if using Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# GitHub Personal Access Token (if using GitHub integration)
# GITHUB_TOKEN=ghp_...

# Other API keys as needed
# SERVICE_API_KEY=...
