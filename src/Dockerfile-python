# Python service image for the Artemis City core (the FastAPI dashboard
# running app/api/main.py). Used by the ``kernel`` compose service. The
# Express boundary container has its own (Node + python3) image and does
# not consume this one.

FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ARTEMIS_ENV=production \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# OS deps psycopg2 needs to compile when installed from source. curl is
# only here for the compose healthcheck (``curl -f http://.../health``).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install runtime Python deps first so this layer caches when only source
# changes. pyproject.toml is the single Python dependency source; uv owns
# environment creation and package installation.
COPY pyproject.toml README.md ./
RUN uv sync --no-dev --no-install-project

# Copy the Python source tree. The FastAPI dashboard imports
# ``app.api.main`` and the bridge / orchestrator code under ``src/``.
COPY src/ ./src/
COPY app/ ./app/

# Drop root for runtime.
RUN useradd --create-home --uid 10001 artemis \
    && chown -R artemis:artemis /app
USER artemis

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uv", "run", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
