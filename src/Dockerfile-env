# Development environment image only — for local dev/testing, not production.
# Uses Warp's dev-base; for production, use the main Dockerfile (Node.js 24-alpine)
# or Dockerfile-python (Python 3.12-slim).

FROM warpdotdev/dev-base:1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    build-essential \
  && rm -rf /var/lib/apt/lists/*
# Install Node.js (matching the version used in the main Dockerfile)
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /src

# Copy dependency files
COPY package*.json ./

# Install all dependencies (including devDependencies for development in Warp)
RUN npm install

# Copy the rest of the application
COPY .. .
