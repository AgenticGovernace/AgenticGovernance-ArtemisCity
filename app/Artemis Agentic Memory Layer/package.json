{
  "name": "Artemis Agentic Memory Layer",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Obsidian vaults.",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/index.ts",
    "lint": "eslint . --ext .ts",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "test:mtls": "tsc && node --test \"dist/__tests__/mtls.test.js\""
  },
  "keywords": [
    "mcp",
    "obsidian",
    "llm",
    "agent",
    "rest-api",
    "knowledge-base"
