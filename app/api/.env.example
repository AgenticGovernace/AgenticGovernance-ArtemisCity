# ============================================
# Artemis City API (app/api) — environment
# ============================================
# Copy this file to app/api/.env and fill in values.
# The setup_secrets.sh script does this automatically and inserts
# generated keys; do NOT commit the resulting .env.

# --------------------------------------------
# Server
# --------------------------------------------
# Express listen port (default: 4000)
API_PORT=4000

# Node environment: development | production
NODE_ENV=development

# Dev-only auth bypass. Must be combined with NODE_ENV=development to
# take effect. NEVER set in production.
# SKIP_AUTH=true

# --------------------------------------------
# API authentication
# --------------------------------------------
# Multi-key auth — one env var per logical user, format:
#   ARTEMIS_API_KEY_<NAME>=<key>:<role>:<perm1,perm2,...>
# At least one key must be configured (or MCP_API_KEY below as fallback).
ARTEMIS_API_KEY_DEFAULT=your_default_api_key_here:admin:read,write,delete,admin

# Fallback key — used when no ARTEMIS_API_KEY_* var is set; assigned admin role.
MCP_API_KEY=your_secure_api_key_here

# --------------------------------------------
# Python bridge (calls src/api_bridge.py)
# --------------------------------------------
# Python interpreter for the bridge subprocess (default: python3)
# ARTEMIS_PYTHON=python3

# Override repo root for the bridge (default: auto-detected by walking
# up from this file until src/api_bridge.py is found).
# ARTEMIS_REPO_ROOT=/absolute/path/to/repo

# Registry SQLite path used by the Python bridge.
# Default: data/agent_registry.db (relative to repo root).
# ARTEMIS_REGISTRY_DB=/absolute/path/to/agent_registry.db

# --------------------------------------------
# Obsidian (read by the Python core via the bridge)
# --------------------------------------------
# Vault filesystem path. Default: <repo-root>/obsidian_vault.
# OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault
