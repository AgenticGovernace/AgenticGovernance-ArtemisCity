# NOTE: In most setups you do NOT need this file. `vite.config.ts` reads
# the project's root `.env` (the one `setup_secrets.sh` writes) and
# already exposes `FASTAPI_API_KEY` / `MCP_API_KEY` to the client. Run
# `make api` + `make frontend` after `setup_secrets.sh` and X-API-Key
# will be set automatically.
#
# Create this file only if you want a frontend-only override that does
# NOT touch the root .env (e.g. pointing the dashboard at a different
# backend than the rest of the stack):
#
# VITE_FASTAPI_API_KEY=<override key>
# VITE_MCP_API_KEY=<override fallback key>
VITE_FASTAPI_API_KEY=x
VITE_MCP_API_KEY=x
