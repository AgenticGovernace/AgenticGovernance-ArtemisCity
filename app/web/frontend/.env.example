# API key for the FastAPI dashboard backend (app/api/main.py).
# Must match either FASTAPI_API_KEY or MCP_API_KEY in the root .env --
# `setup_secrets.sh` writes both; this file mirrors one of them into the
# Vite frontend so api.ts can attach it as `X-API-Key` on every request.
#
# In local dev with no key configured, you can leave this empty -- the
# FastAPI auth dependency is permissive when neither key is set.
VITE_FASTAPI_API_KEY=

# Optional fallback used when VITE_FASTAPI_API_KEY is empty. Most setups
# only need VITE_FASTAPI_API_KEY above; keep this for shared-key setups.
VITE_MCP_API_KEY=
