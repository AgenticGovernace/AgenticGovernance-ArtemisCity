{
  "name": "artemis-city-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Artemis City dashboard — React + Vite client over the FastAPI/Express boundary.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
