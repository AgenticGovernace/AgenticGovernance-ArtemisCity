# Go and Rust. Dependency/vendor trees and lockfiles remain a repository choice.
*.test
coverage.out
target/

# Ruby
*.gem
*.rbc
.bundle/
vendor/bundle/
.ruby-lsp/

# Swift/Xcode. Shared projects and workspaces remain trackable.
DerivedData/
xcuserdata/
*.xcuserstate
.build/

# R and Julia. Reproducibility files such as renv.lock and Manifest.toml stay.
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/
renv/python/
renv/cellar/
.julia/

# Dart/Flutter
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies

# -----------------------------------------------------------------------------
# Logs, process state, local databases, and mutable service data
# -----------------------------------------------------------------------------
*.log
*.log.*
*.pid
*.pid.lock
*.stackdump
*.retry

*.db-journal
*.db-shm
*.db-wal
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.duckdb.wal
dump.rdb
appendonly.aof

# ML/data-tool runtime caches; model definitions and datasets are not broadly
# ignored because their provenance policy varies by repository.
wandb/
mlruns/
lightning_logs/
events.out.tfevents.*
.dvc/cache/

# -----------------------------------------------------------------------------
# Infrastructure state
# -----------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.sample

# Supabase CLI state. Migrations, seed SQL, functions, and snippets stay visible.
supabase/.branches/
supabase/.temp/
supabase/.env

# -----------------------------------------------------------------------------
# AI-assistant runtime state (shared rules/instructions remain trackable)
# -----------------------------------------------------------------------------
**/.claude/settings.local.json
**/.claude/.cc-writes/
**/.claude/worktrees/
**/.codex/.tmp/
**/.codex/auth.json
**/.codex/logs/
**/.codex/sessions/
**/.codex/archived_sessions/
**/.codex/models_cache.json
**/.cursor/index/
**/.cursor/worktrees/
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.*

# -----------------------------------------------------------------------------
# Reproducibility assets intentionally remain trackable
# -----------------------------------------------------------------------------
!**/package-lock.json
!**/npm-shrinkwrap.json
!**/pnpm-lock.yaml
!**/yarn.lock
!**/uv.lock
!**/poetry.lock
!**/Pipfile.lock
!**/Cargo.lock
!**/go.sum
!**/Gemfile.lock
!**/composer.lock
!**/renv.lock
!**/.terraform.lock.hcl

# Archives are intentionally not ignored here. They may be generated bundles or
# source/provenance artifacts, so each repository must make that decision.

# === END QUANTUMHARMONY SHARED BASELINE v1 ===

