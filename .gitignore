# =============================================================================
# QuantumHarmony distributed repository ignore baseline
# quantumharmony-ignore-baseline: 1
# =============================================================================
# Keep the shared block portable across repositories. Repository-specific
# runtime paths and deliberate exceptions belong after the END marker.
#
# Policy:
# - Ignore machine-local state, credentials, caches, generated output, and
#   mutable runtime data.
# - Keep source, schemas, migrations, fixtures, example configuration,
#   dependency lockfiles, and provenance archives visible by default.
# - Add narrow repository exceptions instead of broad rules such as **/data/,
#   *.jar, *.zip, or vendor/, which can hide legitimate shared resources.

# === BEGIN QUANTUMHARMONY SHARED BASELINE v1 ===

# -----------------------------------------------------------------------------
# Operating-system metadata
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100/
.Spotlight-V100/
.TemporaryItems/
.Trashes/
.fseventsd/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
**.smbd*
# -----------------------------------------------------------------------------
# Editors, IDEs, and database clients
# -----------------------------------------------------------------------------
.idea/
.fleet/
.vs/
*.iml
*.iws
*.ipr
*.suo
*.user
*.userosscache
*.sln.docstates

# Keep portable VS Code recommendations/tasks/settings, ignore local additions.
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/*.code-snippets

# Eclipse and DBeaver project state is workstation-specific. SQL migrations,
# schemas, and seed files remain visible because they do not match these rules.
/.metadata/
/.recommenders/
/.classpath
/.project
/.settings/
/.factorypath
/.dbeaver/
/.tableplus/
*.sequelpro

# Editor swap, backup, and recovery files.
*~
*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig
*.rej
**/.history/
**/.tmp/
**/.temp/

# -----------------------------------------------------------------------------
# Local environment, credentials, and signing material
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.defaults
!.env.schema
!.env.*.example
!.env.*.sample
!.env.*.template
.envrc
.envrc.*
!.envrc.example
.direnv/

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.netrc
.pypirc
.npmrc.local
.yarnrc.local
.secrets/
.secrets.*
!.secrets.baseline
credentials.json
credentials.*.json
service-account*.json
*-service-account.json
google-services.json
GoogleService-Info.plist
*.postman_environment.json
kubeconfig
*.kubeconfig
!kubeconfig.example

# Local cloud credentials and deployment link state.
.aws/
.azure/
.gcloud/
.kube/
.docker/config.json
.vercel/
.netlify/
.serverless/
.sst/
.firebase/
.wrangler/
cdk.out/

