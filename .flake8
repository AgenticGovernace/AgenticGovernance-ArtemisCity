[flake8]
# Aligned with black and isort (both pinned to 88 in .pre-commit-config.yaml).
# Leaving flake8 at its 79-column default makes the two formatters fight:
# black reformats to 88, flake8 then reports E501 on every such line.
max-line-length = 88

# Black-incompatible checks, per Black's own documented guidance:
#   E203  whitespace before ':'  — black's slice spacing intentionally emits it
#   E704  statement on same line as def — black formats stub overloads this way
#   W503  line break before binary operator — black prefers the break there
#   D1xx  missing-docstring family — docstring policy is owned by the
#         interrogate hook (--fail-under=80, JSF AV Rules 134-135). Leaving
#         flake8-docstrings unconfigured alongside it enforces an implicit 100%
#         on every public symbol, contradicting that deliberate 80% threshold.
extend-ignore = E203, E704, W503,
    D100, D101, D102, D103, D104, D105, D107,
    D202, D205, D400, D401, D403

exclude =
    .git,
    .agents,
    .venv,
    node_modules,
    __pycache__,
    build,
    dist,
    .pixi,
    # Reverse-sync quarantine (see docs/audits/*-removal-hold.yaml): these
    # are retained comparison evidence with no runtime, import or routing
    # authority, so linting them is meaningless. Their names also contain a
    # space, which per-file-ignores cannot express.
    * 2.py

# ---------------------------------------------------------------------------
# Legacy debt ratchet.
#
# flake8 was previously inert: no config file existed, so it ran at its
# 79-column default against black's 88 and failed on everything. Arming it
# exposed a pre-existing backlog. These per-file entries freeze that backlog
# so the gate applies in full to every new and untouched file, while the
# listed files are burned down individually. Only ever remove lines here.
# ---------------------------------------------------------------------------
per-file-ignores =
    .agents/skills/bigquery-data-transfer-service/scripts/bigquery_dts.py: E501
    .agents/skills/building-data-apps/examples/fastapi_chat.py: E501
