# Provenance mesh — generated from the root .env by setup_secrets.sh
PROV_DB=services/prove/provenance.db
PROV_HOST=127.0.0.1
PROV_PORT=8787
PROV_MCP_HOST=127.0.0.1
PROV_MCP_PORT=8789
PROXY_UPSTREAM=http://127.0.0.1:8787
PROXY_HOST=127.0.0.1
PROXY_PORT=8788
UI_PORT=5173
PROVENANCE_SERVICE_URL=http://127.0.0.1:8787
PROVENANCE_STRICT=1

# --- Mutual TLS -------------------------------------------------------------
# When enabled, the provenance service requires a client certificate signed by
# the local Artemis CA and pinned in `.agent/clients/*.yaml`. Enabling it
# without all three files below is a hard startup failure, never a downgrade —
# the service that mints the audit chain must not accept anonymous writers.
PROV_MTLS_ENABLED=0
PROV_MTLS_CERT=
PROV_MTLS_KEY=
PROV_MTLS_CA=
PROV_MTLS_MIN_VERSION=TLSv1.2
PROV_MTLS_SERVER_CN=localhost

# Client credentials the service's own port probe presents when checking
# whether an occupied port is another instance of itself.
PROV_MTLS_CLIENT_CERT=
PROV_MTLS_CLIENT_KEY=

# Browsers cannot practically present client certificates, so when mTLS is on
# the dashboard talks to provenance_proxy.py over loopback and the proxy holds
# the certificate. Point PROXY_UPSTREAM at https:// and set these three.
PROXY_MTLS_CA=
PROXY_MTLS_CERT=
PROXY_MTLS_KEY=
