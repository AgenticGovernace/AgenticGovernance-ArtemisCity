{
  "uid": "artemis-governance",
  "title": "Artemis City Governance",
  "tags": ["artemis", "governance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Quarantined agents",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "artemis-prometheus" },
      "targets": [
        {
          "expr": "sum(artemis_agents{status=\"quarantined\"})",
          "legendFormat": "quarantined",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Suspended agents",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "artemis-prometheus" },
      "targets": [
        {
          "expr": "sum(artemis_agents{status=\"suspended\"})",
          "legendFormat": "suspended",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Sentinel alerts",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "artemis-prometheus" },
      "targets": [
        {
          "expr": "sum(artemis_hebbian_sentinel_alert)",
          "legendFormat": "alerts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Redis up",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "artemis-prometheus" },
      "targets": [
        { "expr": "redis_up", "legendFormat": "redis", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Governance stores readable",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "artemis-prometheus" },
      "targets": [
        {
          "expr": "min(artemis_governance_scrape_ok)",
          "legendFormat": "stores",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agent trust scores",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "artemis-prometheus" },
      "targets": [
        {
          "expr": "artemis_agent_trust_score",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "unit": "none" },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sentinel oscillation rate by scope",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "artemis-prometheus" },
      "targets": [
        {
          "expr": "artemis_hebbian_sentinel_oscillation_rate",
          "legendFormat": "{{agent}}/{{task_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "unit": "none" },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Governance violations per agent",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "artemis-prometheus" },
      "targets": [
        {
          "expr": "artemis_agent_violations",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redis memory and clients",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "artemis-prometheus" },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "memory bytes",
          "refId": "A"
        },
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    }
  ]
}
