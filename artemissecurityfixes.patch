 # the documented setup_secrets.sh flow.
 from src.mcp import config as _mcp_config  # noqa: F401

+# Only HTTP(S) endpoints are valid MCP servers. Validating the scheme up front
+# prevents a misconfigured base URL from coercing urllib into opening a
+# ``file://`` (local file disclosure) or other unexpected scheme.
+_ALLOWED_URL_SCHEMES = ("http", "https")
+
+
+def _ensure_http_url(url: str) -> str:
+    """Return ``url`` unchanged if it is HTTP(S); otherwise raise ValueError."""
+    scheme = urllib.parse.urlparse(url).scheme.lower()
+    if scheme not in _ALLOWED_URL_SCHEMES:
+        raise ValueError(
+            f"MCP base URL must use http or https, got scheme {scheme!r} in {url!r}"
+        )
+    return url
+

 class MCPOperation(Enum):
     """MCP server operation types."""
@@ -109,6 +124,9 @@ def __init__(
         # Ensure base_url doesn't end with slash
         self.base_url = self.base_url.rstrip("/")

+        # Reject non-HTTP(S) schemes before any request is ever built.
+        _ensure_http_url(self.base_url)
+
         if not self.api_key:
             raise ValueError(
                 "MCP_API_KEY required. Set via environment variable or constructor."
@@ -143,7 +161,8 @@ def _make_request(
         )

         try:
-            with urllib.request.urlopen(req, timeout=self.timeout) as response:
+            # base_url scheme is restricted to http/https in __init__ (validated).
+            with urllib.request.urlopen(req, timeout=self.timeout) as response:  # nosec B310
                 response_data = json.loads(response.read().decode("utf-8"))
                 return MCPResponse.from_json(response_data, response.status)

@@ -319,7 +338,8 @@ def health_check(self) -> bool:
             url = f"{self.base_url}/health"
             req = urllib.request.Request(url, method="GET")

-            with urllib.request.urlopen(req, timeout=5) as response:
+            # base_url scheme is restricted to http/https in __init__ (validated).
+            with urllib.request.urlopen(req, timeout=5) as response:  # nosec B310
                 return response.status == 200
         except Exception:
             # Catch all exceptions during health check (network, timeout, etc.)
