# ============================================
# 🏛️ ARTEMIS CITY - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# ============================================
# 🌐 ACTIVE ENVIRONMENT
# ============================================
# Selects which file in config/environments/ is loaded.
# Must be one of: dev, staging, prod. Defaults to dev when unset.
ARTEMIS_ENV=dev

# ============================================
# 🔐 MCP SERVER CONFIGURATION
# ============================================

# MCP Server base URL (default: http://localhost:3000)
MCP_BASE_URL=http://localhost:3000

# MCP API Key for authentication (required)
# Generate a secure random key: openssl rand -hex 32
MCP_API_KEY=your_secure_api_key_here

# FastAPI dashboard API key (app/api/main.py). When set, requests must
# include X-API-Key: <this value>. Leave blank for local dev with no auth.
# Generated automatically by setup_secrets.sh.
FASTAPI_API_KEY=your_fastapi_api_key_here

# Canonical runtime storage. Relative values are always anchored to the repo
# root, never the current process directory.
# ARTEMIS_DATA_DIR=data
# ARTEMIS_LOG_DIR=logs

# Optional per-store overrides. Absolute paths are useful for containers and
# tests; relative paths remain underneath ARTEMIS_DATA_DIR/ARTEMIS_LOG_DIR.
# ARTEMIS_REGISTRY_DB=
# ARTEMIS_HEBBIAN_DB=
# ARTEMIS_VECTOR_DB=
# ARTEMIS_TRUST_DB=
# ARTEMIS_RUN_LOG_DB=
# ARTEMIS_ATP_DB=
# ARTEMIS_CHECKPOINT_DIR=
# ARTEMIS_KERNEL_STATE=
# ARTEMIS_MEMORY_STORE_DIR=
# ARTEMIS_MEMORY_DECAY_LOG_DIR=
# ARTEMIS_GOVERNANCE_DATA=
# ARTEMIS_LOG_FILE=

# ATP headers can drive capability selection and capability-scoped Hebbian
# learning. Set strict mode to 1 to reject ATP messages with validation errors.
ARTEMIS_ATP_STRICT=0

# Hebbian stability sentinel. This is an observational control: it records
# rolling outcome sign changes and alerts but never rewrites weights or trust.
ARTEMIS_HEBBIAN_SENTINEL_WINDOW=50
ARTEMIS_HEBBIAN_SENTINEL_THRESHOLD=0.4
ARTEMIS_HEBBIAN_SENTINEL_WARMUP=10

# Enables the boot-time vector-memory decay/archival cycle and read-time
# restoration hooks. Set to 0 only for diagnostics or data migrations.
ARTEMIS_MEMORY_DECAY_ENABLED=1

# ============================================
# 📚 OBSIDIAN CONFIGURATION
# ============================================

# Obsidian Local REST API base URL
# Default when running locally: http://localhost:27124
# Docker on Mac/Windows: http://host.docker.internal:27124
OBSIDIAN_BASE_URL=http://localhost:27124

# Obsidian Local REST API Key
# Get this from Obsidian -> Settings -> Local REST API
OBSIDIAN_API_KEY=your_obsidian_api_key_here

# Obsidian vault filesystem path used by the MCP orchestrator.
# Default: <repo-root>/obsidian_vault (created on demand).
# OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault

# Vault-relative agent folder names (do NOT include OBSIDIAN_VAULT_PATH; the
# orchestrator joins them under the vault root via ObsidianManager).
# AGENT_INPUT_DIR=Agent Inputs
# AGENT_OUTPUT_DIR=Agent Outputs

# ============================================
# 🔧 OPTIONAL CONFIGURATION
# ============================================

# MCP Server Port (if running the server)
PORT=3000

# Log Level: DEBUG, INFO, WARN, ERROR
MCP_LOG_LEVEL=INFO

# Python virtual environment path (if non-standard)
VIRTUAL_ENV=
# ============================================
# EXO CLUSTER (local LLM inference)
# ============================================

# EXO API base URL (default: http://localhost:52415)
EXO_BASE_URL=http://localhost:52415

# Full EXO model endpoint URL. LLMAgent appends /v1 if it is missing.
EXO_MODEL_URL=

# Explicit model ID. Blank auto-detects a running model, then falls back to
# mlx-community/Qwen3-0.6B-4bit when the cluster has no loaded model.
EXO_MODEL_ID=

# ============================================
# HUGGING FACE DATASETS (evaluation pipeline)
# ============================================

# Official Hugging Face Hub token variable. Leave blank for public datasets;
# gated/private datasets can instead request hidden input at runtime with
# --prompt-for-hf-token. Never pass tokens directly as CLI arguments.
HF_TOKEN=

# Optional defaults for src/Experiments/legal_summarization.
LEGAL_DATASET_ID=amjadali070/legal-judgements-en-ur-sd
LEGAL_DATASET_REVISION=main
# LEGAL_DATASET_PATH=/absolute/path/to/local/parquet
# LEGAL_DATASET_NAME=
# HF_DATASETS_CACHE=

# ============================================
# EXTERNAL API KEYS (Add as needed)
# ============================================

# OpenAI API Key (if using AI features)
# OPENAI_API_KEY=sk-...

# Anthropic API Key (if using Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# GitHub Personal Access Token (if using GitHub integration)
# GITHUB_TOKEN=ghp_...

# Other API keys as needed
# SERVICE_API_KEY=...
