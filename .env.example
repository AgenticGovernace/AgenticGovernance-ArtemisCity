# Artemis City — root runtime environment
#
# This file is a contract, not a secret store. Keep the key names and sections
# intact; setup_secrets.sh fills missing generated secrets and preserves values
# you have already configured. Never commit a populated .env file.

# ---------------------------------------------------------------------------
# Runtime identity and local HTTP clients
# ---------------------------------------------------------------------------
ARTEMIS_ENV=dev
ARTEMIS_LOG_LEVEL=INFO
MCP_BASE_URL=http://localhost:3000
MCP_API_KEY=
FASTAPI_API_KEY=
FASTAPI_CORS_ORIGINS=
VITE_FASTAPI_API_KEY=
VITE_MCP_API_KEY=
MCP_LOG_LEVEL=INFO
PORT=3000
API_PORT=4000
NODE_ENV=development
DEBUG=
POSTHOG_PROJECT_TOKEN=<your-posthog-project-token>
POSTHOG_HOST=<your-posthog-host>
SKIP_AUTH=false
ARTEMIS_API_RATE_LIMIT_WINDOW_MS=60000
ARTEMIS_API_RATE_LIMIT_MAX_REQUESTS=100

# Express authentication. The value is key:role:permissions. The key portion
# is generated and rotated by setup_secrets.sh; the role/permissions suffix is
# configuration and is preserved during normal sync.
ARTEMIS_API_KEY_DEFAULT=
# Add additional logical users as ARTEMIS_API_KEY_<NAME>=key:role:perm1,perm2.
VIRTUAL_ENV_PROMPT =
# Authstructure verification is public operator configuration, not secret
# material owned by setup_secrets.sh. The verifier remains unavailable until
# the external verification contract is published and configured.
# Use HTTPS; plain HTTP is accepted only for localhost/127.0.0.1 fixtures.
ARTEMIS_AUTHSTRUCTURE_URL=
ARTEMIS_AUTHSTRUCTURE_AUDIENCE=artemis-city
ARTEMIS_AUTHSTRUCTURE_SIGNER_NAMESPACE=
ARTEMIS_AUTHSTRUCTURE_RECEIPT_KEY_ID=

# Interpreter/repository overrides used by the TypeScript -> Python bridge.
ARTEMIS_PYTHON=
ARTEMIS_REPO_ROOT=
VIRTUAL_ENV=

# ---------------------------------------------------------------------------
# Canonical runtime storage (relative paths live under data/ and logs/)
# ---------------------------------------------------------------------------
ARTEMIS_DATA_DIR=data
ARTEMIS_LOG_DIR=logs
ARTEMIS_REGISTRY_DB=
ARTEMIS_HEBBIAN_DB=
ARTEMIS_VECTOR_DB=
ARTEMIS_TRUST_DB=
ARTEMIS_RUN_LOG_DB=
ARTEMIS_ATP_DB=
ARTEMIS_DELEGATION_DB=
ARTEMIS_CHECKPOINT_DIR=
ARTEMIS_KERNEL_STATE=
ARTEMIS_MEMORY_STORE_DIR=
ARTEMIS_MEMORY_DECAY_LOG_DIR=
ARTEMIS_GOVERNANCE_DATA=
ARTEMIS_GOVERNANCE_LOG=
ARTEMIS_LOG_FILE=
ARTEMIS_LEGAL_SUMMARIZATION_DB=
ARTEMIS_LEGAL_SUMMARIZATION_LOG_DIR=
ARTEMIS_WORKFLOW_VAULT=
ARTEMIS_MINIMAL_VAULT=

# ---------------------------------------------------------------------------
# Obsidian vault and standalone MCP settings
# ---------------------------------------------------------------------------
OBSIDIAN_BASE_URL=http://localhost:27124
OBSIDIAN_API_KEY=
OBSIDIAN_CA_CERT=
OBSIDIAN_VAULT_PATH=
AGENT_INPUT_DIR=Agent Inputs
AGENT_OUTPUT_DIR=Agent Outputs

# MCP server transport identity and HTTP authorization. These are operator
# credentials/claims and are deliberately never generated.
ARTEMIS_MCP_TRANSPORT=stdio
ARTEMIS_MCP_PRINCIPAL_ID=
ARTEMIS_MCP_CAPABILITIES=
ARTEMIS_MCP_BEARER_TOKEN=
ARTEMIS_MCP_HTTP_CLIENT_ID=
ARTEMIS_MCP_HTTP_SUBJECT=
ARTEMIS_MCP_HTTP_SCOPES=
ARTEMIS_MCP_AUTH_ISSUER_URL=
ARTEMIS_MCP_RESOURCE_SERVER_URL=

# ---------------------------------------------------------------------------
# Exo local inference
# ---------------------------------------------------------------------------
EXO_BASE_URL=http://localhost:52415
EXO_MODEL_URL=
EXO_MODEL_ID=
EXO_API_KEY=
EXO_CONNECT_TIMEOUT_SECONDS=10
EXO_READ_TIMEOUT_SECONDS=900
EXO_MAX_RETRIES=2
EXO_RETRY_BACKOFF_SECONDS=1
EXO_RETRY_MAX_DELAY_SECONDS=60
ARTEMIS_EXO_SUMMARY_THRESHOLD_CHARS=12000
ARTEMIS_SYNTHETIC_AGENT_FALLBACK=0
ARTEMIS_SSE_HEARTBEAT_SECONDS=15

# ---------------------------------------------------------------------------
# Routing, ATP, memory, governance, and vector backends
# ---------------------------------------------------------------------------
ARTEMIS_ATP_STRICT=0
ARTEMIS_HEBBIAN_ROUTING=1
ARTEMIS_ROUTING_KERNEL=1
ARTEMIS_HEBBIAN_ROUTING_ALPHA=0.3
ARTEMIS_HEBBIAN_ROUTING_BETA=0.0
ARTEMIS_ROUTING_TRUST_FLOOR=0.0
ARTEMIS_ROUTING_FALLBACK_CAPABILITY=llm_chat
ARTEMIS_HEBBIAN_SENTINEL_WINDOW=50
ARTEMIS_HEBBIAN_SENTINEL_THRESHOLD=0.4
ARTEMIS_HEBBIAN_SENTINEL_WARMUP=10
ARTEMIS_MEMORY_DECAY_ENABLED=1

# Canonical SQL memory ledger. Database URLs are operator-supplied and are
# deliberately blank: use a Neon pooled URL at runtime and a direct URL only
# for migrations. setup_secrets.sh preserves both values and never creates or
# rotates them.
ARTEMIS_MEMORY_BACKEND=legacy
ARTEMIS_MEMORY_DATABASE_URL=
ARTEMIS_MEMORY_MIGRATION_DATABASE_URL=
ARTEMIS_MEMORY_DB_CONNECT_TIMEOUT_SECONDS=10
# Positive PostgreSQL statement deadline applied to every runtime connection.
ARTEMIS_MEMORY_DB_STATEMENT_TIMEOUT_MS=5000
ARTEMIS_MEMORY_OUTBOX_MAX_ATTEMPTS=10
ARTEMIS_MEMORY_OUTBOX_RETRY_BASE_SECONDS=1

ARTEMIS_VECTOR_BACKEND=sqlite
ARTEMIS_VECTOR_TABLE=artemis_vectors
ARTEMIS_VECTOR_DIM=16
ARTEMIS_SUPABASE_DB_URL=
SUPABASE_DB_URL=

# Optional Anaconda Agent Studio integration.
ANACONDA_DESKTOP_URL=http://127.0.0.1:54321
ANACONDA_API_KEY=
ANACONDA_AGENT_PORTS=

# ---------------------------------------------------------------------------
# Evaluation and external providers (never generated automatically)
# ---------------------------------------------------------------------------
HF_TOKEN=
HUGGINGFACE_API_KEY=
LEGAL_DATASET_ID=amjadali070/legal-judgements-en-ur-sd
LEGAL_DATASET_REVISION=main
LEGAL_DATASET_PATH=
LEGAL_DATASET_NAME=
HF_DATASETS_CACHE=data/huggingface
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
ARTEMIS_EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Docker/deployment contract from docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------
ARTEMIS_KERNEL_URL=http://kernel:8000
ARTEMIS_REGISTRY_URL=http://registry:8002
ARTEMIS_MEMORY_BUS_URL=http://memory-bus:8001
ARTEMIS_VECTOR_STORE_URL=http://vector-store:6333
ARTEMIS_VECTOR_STORE_API_KEY=
ARTEMIS_REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
ARTEMIS_MEMORY_WRITE_TIMEOUT_MS=200
ARTEMIS_MEMORY_SYNC_TIMEOUT_MS=300
ARTEMIS_MEMORY_CACHE_SIZE_MB=100
ARTEMIS_MEMORY_QUEUE_MAX_BYTES=10485760
ARTEMIS_EMBEDDING_MODEL=text-embedding-3-large
ARTEMIS_EMBEDDING_BATCH_SIZE=100
ARTEMIS_APPROVAL_TIER1_ENABLED=true
ARTEMIS_APPROVAL_TIER2_TIMEOUT_HOURS=24
ARTEMIS_APPROVAL_TIER3_TIMEOUT_HOURS=72
ARTEMIS_AUTO_ROLLBACK_ON_ERRORS=true
ARTEMIS_AUTO_ROLLBACK_ERROR_THRESHOLD=0.05
ARTEMIS_SANDBOX_VIOLATION_QUARANTINE_COUNT=3
ARTEMIS_SANDBOX_VIOLATION_DECAY_DAYS=30
QDRANT_API_KEY=
GRAFANA_PASSWORD=
ARTEMIS_PROMETHEUS_ENABLED=true
ARTEMIS_PROMETHEUS_URL=http://localhost:9090
ARTEMIS_PROMETHEUS_TIMEOUT=3
ARTEMIS_METRICS_PORT=9090
ARTEMIS_LOG_FORMAT=json

# Deployment tuning knobs documented in DEPLOYMENT.md. They are intentionally
# present even though the current in-process services do not consume all of
# them yet.
ARTEMIS_CACHE_SHARED=false
ARTEMIS_DB_POOL_SIZE=20
ARTEMIS_REDIS_POOL_SIZE=10
ARTEMIS_VECTOR_STORE_POOL_SIZE=5

# ---------------------------------------------------------------------------
# Provenance service, proxy, MCP transport, and UI
# ---------------------------------------------------------------------------
PROV_DB=services/prove/provenance.db
PROV_HOST=127.0.0.1
PROV_PORT=8787
PROV_MCP_HOST=127.0.0.1
PROV_MCP_PORT=8789
PROXY_UPSTREAM=http://127.0.0.1:8787
PROXY_HOST=127.0.0.1
PROXY_PORT=8788
UI_PORT=5173
PROVENANCE_SERVICE_URL=http://127.0.0.1:8787
PROVENANCE_STRICT=1

# ============================================
# 🔐 MUTUAL TLS (memory server)
# ============================================
# When enabled, the memory server terminates HTTPS and requires every client to
# present a certificate signed by the local Artemis CA and pinned in
# `.agent/clients/*.yaml`. Provision the CA and certificates with:
#   scripts/mtls/artemis-mtls.sh init-ca
#   scripts/mtls/artemis-mtls.sh issue-server
#   scripts/mtls/artemis-mtls.sh issue-client <agent-id> --routes '/api/getContext'
#
# Leaving this off keeps the historical plaintext listener, authenticated by
# MCP_API_KEY alone — replayable by any local process that can read this file.
ARTEMIS_MTLS_ENABLED=0

# Server key material. Paths are printed by `issue-server`. Enabling mTLS
# without all three is a hard startup failure, never a silent downgrade.
ARTEMIS_MTLS_CERT=
ARTEMIS_MTLS_KEY=
ARTEMIS_MTLS_CA=

# Interface to bind. Loopback by default — this is a local trust domain.
ARTEMIS_MTLS_HOST=127.0.0.1

# Lowest accepted TLS version: TLSv1.2 or TLSv1.3.
ARTEMIS_MTLS_MIN_VERSION=TLSv1.2

# Keep requiring MCP_API_KEY on top of the certificate. Certificates answer
# "who are you"; the token carries scope and is cheap to rotate. Set to 0 to
# make the certificate the sole factor.
ARTEMIS_MTLS_REQUIRE_BEARER=1

# Where client manifests and handshake ledgers live. Defaults to `<repo>/.agent`.
# Point this at an Obsidian vault to version the registry alongside your notes.
ARTEMIS_AGENT_DIR=

# Dashboard: flag certificates as "expiring soon" this many days before expiry.
ARTEMIS_MTLS_EXPIRY_WARNING_DAYS=14

# ============================================
# 🔐 MUTUAL TLS (provenance service — services/prove)
# ============================================
# Same CA and same `.agent/clients` registry as the memory server; one identity
# domain governs the whole mesh. See .agent/README.md.
PROV_MTLS_ENABLED=0
PROV_MTLS_CERT=
PROV_MTLS_KEY=
PROV_MTLS_CA=
PROV_MTLS_MIN_VERSION=TLSv1.2
PROV_MTLS_SERVER_CN=localhost
PROV_MTLS_CLIENT_CERT=
PROV_MTLS_CLIENT_KEY=

# Credentials the worker proxy presents upstream when the provenance service
# enforces mTLS. Lets the browser dashboard stay out of the certificate business.
PROXY_MTLS_CA=
PROXY_MTLS_CERT=
PROXY_MTLS_KEY=
