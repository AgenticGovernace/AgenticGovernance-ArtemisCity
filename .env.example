# ============================================
# ARTEMIS CITY - ROOT LOCAL ENV EXAMPLE
# ============================================
# Copy to .env or run ./setup_secrets.sh.
# Never commit real .env files.

# Local vault access
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian/vault

# Python clients and demos
MCP_BASE_URL=http://localhost:3000
MCP_API_KEY=<auto-generated-64-char-hex>

# MCP server defaults
PORT=3000
OBSIDIAN_BASE_URL=http://localhost:27124
OBSIDIAN_API_KEY=<your_obsidian_api_key>
MCP_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_MESSAGE="Too many requests, please try again later."
PROXY_TIMEOUT=5000
WORKER_POOL_SIZE=4
STORAGE_PATH=

# FastAPI dashboard
FASTAPI_API_KEY=<auto-generated-64-char-hex>
FASTAPI_CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Express web API server
API_PORT=4000
NODE_ENV=development
SKIP_AUTH=false
ARTEMIS_API_KEY_ARTEMIS=<secret-key>:admin:read,write,delete,admin
ARTEMIS_API_KEY_PACKRAT=<secret-key>:service:read,write,search
ARTEMIS_API_KEY_COPILOT=<secret-key>:assistant:read,search,query
ARTEMIS_API_KEY_DAEMON=<secret-key>:service:read,write,system

# Optional legal summarization experiment
LEGAL_DATASET_PATH=/absolute/path/to/legal-judgements-en-ur-sd
